# Server Configuration
PROJECT_NAME="AI-Based Healthcare Management System"
VERSION="1.0.0"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Security & JWT
SECRET_KEY="replace_this_with_a_secure_32_byte_secret_key_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For SQLite local dev: sqlite:///./healthcare.db
# For PostgreSQL: postgresql://user:password@localhost:5432/healthcare_db
DATABASE_URL="sqlite:///./healthcare.db"

# CORS Allowed Origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# AI LLM Provider Configuration (Optional - safe fallback will activate if unset)
# Provider options: "gemini", "openai", "fallback"
AI_PROVIDER="fallback"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# Email / SMTP Settings (Optional)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
EMAILS_FROM_EMAIL="noreply@healthcare-ai.local"
EMAILS_FROM_NAME="AI Healthcare System"
